<?xml version="1.0" encoding="utf-8"?>
<!--
  DataStore preferences live under files/datastore/, not sharedpref/.
  Exclude receiver IDs, settings, crash logs, and diagnostics from cloud backup.
  Android excludes cache/ by design; diagnostics exports currently use
  cache/diagnostics/ and files/diagnostics/ is excluded for any future move.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="datastore/" />
    <exclude
        domain="sharedpref"
        path="soundkit_settings.preferences_pb" />
    <exclude
        domain="file"
        path="crashes/" />
    <exclude
        domain="file"
        path="diagnostics/" />
</full-backup-content>
